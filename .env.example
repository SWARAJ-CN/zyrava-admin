# This file is intentionally not used by the admin console.
#
# The admin API runs inside the existing zyrava-server, so all server-side
# settings belong there, in zyrava-server/.env:
#
#   ADMIN_EMAIL=you@example.com
#   ADMIN_PASSWORD=use-a-long-unique-password
#   ADMIN_JWT_SECRET=<64 random hex chars>
#   ADMIN_SESSION_HOURS=12
#   ADMIN_ALLOW_DELETE=true
#   ADMIN_CACHE_TTL_MS=5000
#
# The only client-side setting is VITE_API_URL; see client/.env.example.
# Never put MONGO_URI or admin credentials in the frontend.
